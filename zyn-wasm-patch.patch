@@ -12,9 +12,11 @@
 #ifndef ZYNSEMA_H
 #define ZYNSEMA_H
 
-#if defined __APPLE__ || defined WIN32
+#if defined __APPLE__ || defined WIN32 || defined __EMSCRIPTEN__
 
+#ifndef __EMSCRIPTEN__
 #include <pthread.h>
+#endif
 
 namespace zyn {
 
@@ -27,35 +29,50 @@ public:
 
     ~ZynSema (void)
     {
+#ifndef __EMSCRIPTEN__
         pthread_mutex_destroy (&_mutex);
         pthread_cond_destroy (&_cond);
+#endif
     }
 
     int init (int, int v)
     {
         _count = v;
+#ifndef __EMSCRIPTEN__
         return pthread_mutex_init (&_mutex, 0) || pthread_cond_init (&_cond, 0);
+#else
+        return 0;
+#endif
     }
 
     int post (void)
     {
+#ifndef __EMSCRIPTEN__
         pthread_mutex_lock (&_mutex);
         if (++_count == 1) pthread_cond_signal (&_cond);
         pthread_mutex_unlock (&_mutex);
+#else
+        ++_count;
+#endif
         return 0;
     }
 
     int wait (void)
     {
+#ifndef __EMSCRIPTEN__
         pthread_mutex_lock (&_mutex);
         while (_count < 1) pthread_cond_wait (&_cond, &_mutex);
         --_count;
         pthread_mutex_unlock (&_mutex);
+#else
+        if (_count > 0) --_count;
+#endif
         return 0;
     }
 
     int trywait (void)
     {
+#ifndef __EMSCRIPTEN__
         if (pthread_mutex_trylock (&_mutex)) return -1;
         if (_count < 1)
         {
@@ -65,6 +82,11 @@ public:
         --_count;
         pthread_mutex_unlock (&_mutex);
         return 0;
+#else
+        if (_count < 1) return -1;
+        --_count;
+        return 0;
+#endif
     }
 
     int getvalue (void) const
@@ -75,8 +97,10 @@ public:
 
 private:
     int              _count;
+#ifndef __EMSCRIPTEN__
     pthread_mutex_t  _mutex;
     pthread_cond_t   _cond;
+#endif
 };
 
